# Vision grader — DeepSeek by default.
# Register at https://platform.deepseek.com, top up a few CNY, create an API key.
GRADE_API_KEY=
GRADE_MODEL=deepseek-flash
# OpenAI-compatible base URL; swap provider by changing this.
GRADE_BASE_URL=https://api.deepseek.com

# Site URL printed on the shareable scorecard
NEXT_PUBLIC_SITE_URL=getshotscore.com
